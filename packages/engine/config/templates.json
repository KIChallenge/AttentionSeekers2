  "backtest_gtelg_2023": {
    "$comment": "Historical backtest (FR-H7): GTelG-Novelle 2023 (eImpfpass), ME 260/ME XXVII, first draft 2023-04-05 (sent 2023-04-04); run with --as-of 2023-04-03. Topics are the measures of the consultation draft as coded for the comparison; the outcome is not in them. 2023 profiles replace the 2026 ones; red lines and dossiers are not used (they postdate the cutoff). Rule: the government side (ministry, finance, NR majority) are the veto players and a third of the table suffices.",
    "decisionRule": "veto_players",
    "qualifiedMajority": {
      "needed": 1,
      "of": 3
    },
    "roundLimit": 5,
    "budgetCeilingPct": 0,
    "agents": ["gm", "fm", "nr", "sv", "ak", "bl", "abk", "wk", "pv"],
    "topics": [
      {
        "id": "t-voll",
        "key": "eimpf_full_operation",
        "label": {
          "de": "Speicherpflicht",
          "en": "Storage duty"
        },
        "measure": {
          "de": "Vollbetrieb des eImpfpasses: alle impfenden Gesundheitsdiensteanbieter (Ärzt:innen einschließlich Wahlärzt:innen, Amtsärzt:innen, diplomierte Pflegekräfte, Labore bei Antikörpertests) speichern ab einem per Verordnung festgelegten Zeitpunkt jede Impfung im zentralen Impfregister",
          "en": "Full operation of the e-vaccination pass: every vaccinating provider (doctors including private-practice doctors, public health officers, registered nurses, labs for antibody tests) stores every vaccination in the central register from a date set by ordinance"
        }
      },
      {
        "id": "t-nachtrag",
        "key": "retro_entry",
        "label": {
          "de": "Nachtragung",
          "en": "Retro entry"
        },
        "measure": {
          "de": "Verordnungsermächtigung, frühere Impfungen gegen Masern, Röteln, Hepatitis A und B, Varizellen, Polio und HPV verpflichtend im Impfregister nachzutragen",
          "en": "Ordinance power to make retroactive entry of past vaccinations against measles, rubella, hepatitis A and B, varicella, polio and HPV mandatory"
        }
      },
      {
        "id": "t-verantw",
        "key": "ministry_controller",
        "label": {
          "de": "Verantwortung",
          "en": "Controller"
        },
        "measure": {
          "de": "Nach der Pilotphase übernimmt das Gesundheitsministerium statt der ELGA GmbH Betrieb und datenschutzrechtliche Verantwortung für das zentrale Impfregister, mit gesetzlich festgelegter Rollen- und Pflichtenverteilung nach DSGVO",
          "en": "After the pilot, the health ministry instead of ELGA GmbH runs the central register and is its data controller, with roles and duties under the GDPR set in the act"
        }
      },
      {
        "id": "t-service",
        "key": "ehealth_service_desk",
        "label": {
          "de": "Servicestelle",
          "en": "Service desk"
        },
        "measure": {
          "de": "Neue eHealth-Servicestelle als Auftragsverarbeiterin des Ministeriums für Auskunftsbegehren und das Datenqualitätsmanagement des Impfregisters, neben der bestehenden ELGA-Ombudsstelle",
          "en": "A new eHealth service desk, processor for the ministry, for access requests and data quality of the register, next to the existing ELGA ombudsman office"
        }
      },
      {
        "id": "t-auswertung",
        "key": "public_health_use",
        "label": {
          "de": "Auswertung",
          "en": "Data use"
        },
        "measure": {
          "de": "Personenbezogene Verarbeitung der Impfregisterdaten für Impferinnerungen, persönliche Impfkalender, Durchimpfungsraten und die Steuerung des öffentlichen Gesundheitsdienstes",
          "en": "Personal-level use of register data for vaccination reminders, personal schedules, coverage rates and steering of the public health service"
        }
      },
      {
        "id": "t-kosten",
        "key": "interface_costs",
        "label": {
          "de": "Kostentragung",
          "en": "Cost bearing"
        },
        "measure": {
          "de": "Schnittstellen und Dokumentationsaufwand tragen die Gesundheitsdiensteanbieter und Spitalsträger selbst, ohne gesonderte Abgeltung; Mehrkosten des Bundes im Ressortbudget",
          "en": "Providers and hospital owners bear interface and documentation costs themselves with no separate compensation; federal extra costs within the ministry budget"
        }
      },
