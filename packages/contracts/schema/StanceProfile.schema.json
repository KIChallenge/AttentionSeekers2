{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "ministry_health",
        "social_insurance",
        "medical_chamber",
        "contract_physicians",
        "elective_physicians",
        "hospitals",
        "nursing",
        "patients",
        "legislature",
        "ministry_finance",
        "laender",
        "public_health",
        "chamber_commerce",
        "chamber_labour",
        "chamber_agriculture",
        "industry_pharma",
        "other"
      ]
    },
    "topicKey": {
      "type": "string"
    },
    "year": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "stance": {
      "type": "number",
      "minimum": -2,
      "maximum": 2
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "support": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "segmentId": {
            "type": "string"
          },
          "start": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "end": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "recencyWeight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "sourceId",
          "segmentId",
          "start",
          "end",
          "recencyWeight"
        ]
      }
    },
    "fit": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "halfLifeYears": {
          "type": "number"
        },
        "method": {
          "type": "string",
          "const": "llm_derived_spot_checked"
        }
      },
      "required": [
        "n",
        "from",
        "to",
        "halfLifeYears",
        "method"
      ]
    }
  },
  "required": [
    "role",
    "topicKey",
    "year",
    "stance",
    "confidence",
    "support",
    "fit"
  ]
}
