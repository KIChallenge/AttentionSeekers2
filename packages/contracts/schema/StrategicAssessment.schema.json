{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string"
    },
    "agentId": {
      "type": "string",
      "pattern": "^[a-z]{2,4}$"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "leverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "object",
            "properties": {
              "lang": {
                "type": "string",
                "enum": [
                  "de",
                  "en"
                ]
              },
              "text": {
                "type": "string"
              },
              "translations": {
                "default": {},
                "type": "object",
                "properties": {
                  "de": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "lang",
              "text"
            ]
          },
          "sourceRef": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "sourceId": {
                    "type": "string"
                  },
                  "segmentId": {
                    "type": "string"
                  },
                  "start": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "end": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "recencyWeight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "sourceId",
                  "segmentId",
                  "start",
                  "end",
                  "recencyWeight"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "text",
          "sourceRef"
        ]
      }
    },
    "vetoStatus": {
      "type": "string",
      "enum": [
        "formal_veto",
        "co_decider",
        "consultative"
      ]
    },
    "vetoBasis": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "lang": {
              "type": "string",
              "enum": [
                "de",
                "en"
              ]
            },
            "text": {
              "type": "string"
            },
            "translations": {
              "default": {},
              "type": "object",
              "properties": {
                "de": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "lang",
            "text"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "batna": {
      "type": "object",
      "properties": {
        "text": {
          "type": "object",
          "properties": {
            "lang": {
              "type": "string",
              "enum": [
                "de",
                "en"
              ]
            },
            "text": {
              "type": "string"
            },
            "translations": {
              "default": {},
              "type": "object",
              "properties": {
                "de": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "lang",
            "text"
          ]
        },
        "value": {
          "type": "number",
          "minimum": -2,
          "maximum": 2
        }
      },
      "required": [
        "text",
        "value"
      ]
    },
    "coalitionOptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "withAgents": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2,4}$"
            }
          },
          "topicIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "overlap": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "note": {
            "type": "object",
            "properties": {
              "lang": {
                "type": "string",
                "enum": [
                  "de",
                  "en"
                ]
              },
              "text": {
                "type": "string"
              },
              "translations": {
                "default": {},
                "type": "object",
                "properties": {
                  "de": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "lang",
              "text"
            ]
          }
        },
        "required": [
          "withAgents",
          "topicIds",
          "overlap",
          "note"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string",
            "pattern": "^[a-z]{2,4}$"
          },
          "direction": {
            "type": "string",
            "enum": [
              "needs",
              "needed_by",
              "mutual"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "financing",
              "competence",
              "self_governance",
              "legislation",
              "implementation",
              "other"
            ]
          },
          "note": {
            "type": "object",
            "properties": {
              "lang": {
                "type": "string",
                "enum": [
                  "de",
                  "en"
                ]
              },
              "text": {
                "type": "string"
              },
              "translations": {
                "default": {},
                "type": "object",
                "properties": {
                  "de": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "lang",
              "text"
            ]
          }
        },
        "required": [
          "agentId",
          "direction",
          "kind",
          "note"
        ]
      }
    },
    "incentives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proposalId": {
            "type": "string"
          },
          "dimension": {
            "type": "string",
            "enum": [
              "cost",
              "revenue",
              "workload",
              "competence",
              "political_credit"
            ]
          },
          "sign": {
            "anyOf": [
              {
                "type": "number",
                "const": -1
              },
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 1
              }
            ]
          },
          "magnitude": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "note": {
            "type": "object",
            "properties": {
              "lang": {
                "type": "string",
                "enum": [
                  "de",
                  "en"
                ]
              },
              "text": {
                "type": "string"
              },
              "translations": {
                "default": {},
                "type": "object",
                "properties": {
                  "de": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "lang",
              "text"
            ]
          },
          "sourceRef": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "sourceId": {
                    "type": "string"
                  },
                  "segmentId": {
                    "type": "string"
                  },
                  "start": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "end": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "recencyWeight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "sourceId",
                  "segmentId",
                  "start",
                  "end",
                  "recencyWeight"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "proposalId",
          "dimension",
          "sign",
          "magnitude",
          "note",
          "sourceRef"
        ]
      }
    },
    "cooperationVsBlockade": {
      "type": "object",
      "properties": {
        "lean": {
          "type": "string",
          "enum": [
            "cooperate",
            "conditional",
            "block"
          ]
        },
        "blockadeRisk": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "object",
          "properties": {
            "lang": {
              "type": "string",
              "enum": [
                "de",
                "en"
              ]
            },
            "text": {
              "type": "string"
            },
            "translations": {
              "default": {},
              "type": "object",
              "properties": {
                "de": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "lang",
            "text"
          ]
        }
      },
      "required": [
        "lean",
        "blockadeRisk",
        "reason"
      ]
    }
  },
  "required": [
    "runId",
    "agentId",
    "round",
    "leverage",
    "vetoStatus",
    "vetoBasis",
    "batna",
    "coalitionOptions",
    "dependencies",
    "incentives",
    "cooperationVsBlockade"
  ]
}
