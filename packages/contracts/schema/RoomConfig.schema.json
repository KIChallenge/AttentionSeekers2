{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "template": {
      "type": "string",
      "enum": [
        "wartezeiten",
        "honorarverhandlungen",
        "spitalsplanung",
        "pflegereform",
        "pve",
        "impfstrategie",
        "neue_leistungen",
        "backtest_svog_2018",
        "custom"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "lang": {
      "type": "string",
      "enum": [
        "de",
        "en"
      ]
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string",
            "pattern": "^[a-z]{2,4}$"
          },
          "enabled": {
            "type": "boolean"
          },
          "origin": {
            "type": "string",
            "enum": [
              "core",
              "optional"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "fitted",
              "prompted"
            ]
          },
          "suggestedByModerator": {
            "type": "boolean"
          },
          "reason": {
            "type": "object",
            "properties": {
              "lang": {
                "type": "string",
                "enum": [
                  "de",
                  "en"
                ]
              },
              "text": {
                "type": "string"
              },
              "translations": {
                "default": {},
                "type": "object",
                "properties": {
                  "de": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "lang",
              "text"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "temperament": {
            "type": "object",
            "properties": {
              "concession": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "assertiveness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "coalitionAppetite": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "riskTolerance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "concession",
              "assertiveness",
              "coalitionAppetite",
              "riskTolerance"
            ]
          }
        },
        "required": [
          "agentId",
          "enabled",
          "origin",
          "mode",
          "suggestedByModerator",
          "reason",
          "model",
          "temperament"
        ]
      }
    },
    "moderatorModel": {
      "type": "string",
      "minLength": 1
    },
    "expertModel": {
      "type": "string",
      "minLength": 1
    },
    "decisionRule": {
      "type": "string",
      "enum": [
        "consensus",
        "qualified_majority",
        "veto_players"
      ]
    },
    "qualifiedMajority": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "needed": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "of": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "needed",
            "of"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "roundLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "budgetCeiling": {
      "type": "object",
      "properties": {
        "maxIncreasePct": {
          "type": "number"
        },
        "baselineEurBn": {
          "type": [
            "number",
            "null"
          ]
        },
        "note": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "lang": {
                  "type": "string",
                  "enum": [
                    "de",
                    "en"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "translations": {
                  "default": {},
                  "type": "object",
                  "properties": {
                    "de": {
                      "type": "string"
                    },
                    "en": {
                      "type": "string"
                    }
                  }
                }
              },
              "required": [
                "lang",
                "text"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "maxIncreasePct",
        "baselineEurBn",
        "note"
      ]
    },
    "asOf": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "climate": {
      "type": "string",
      "enum": [
        "cooperative",
        "neutral",
        "confrontational"
      ]
    },
    "pressures": {
      "type": "object",
      "properties": {
        "time": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        },
        "budget": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        },
        "public": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "time",
        "budget",
        "public"
      ]
    },
    "scheduledEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "atRound": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "statistic",
              "court_ruling",
              "press_report",
              "budget_shock",
              "political",
              "other"
            ]
          },
          "title": {
            "type": "object",
            "properties": {
              "lang": {
                "type": "string",
                "enum": [
                  "de",
                  "en"
                ]
              },
              "text": {
                "type": "string"
              },
              "translations": {
                "default": {},
                "type": "object",
                "properties": {
                  "de": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "lang",
              "text"
            ]
          },
          "body": {
            "type": "object",
            "properties": {
              "lang": {
                "type": "string",
                "enum": [
                  "de",
                  "en"
                ]
              },
              "text": {
                "type": "string"
              },
              "translations": {
                "default": {},
                "type": "object",
                "properties": {
                  "de": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "lang",
              "text"
            ]
          },
          "sourceRef": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "sourceId": {
                    "type": "string"
                  },
                  "segmentId": {
                    "type": "string"
                  },
                  "start": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "end": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "recencyWeight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "sourceId",
                  "segmentId",
                  "start",
                  "end",
                  "recencyWeight"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "atRound",
          "kind",
          "title",
          "body",
          "sourceRef"
        ]
      }
    },
    "coldRatification": {
      "type": "boolean"
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "template",
    "question",
    "lang",
    "agents",
    "moderatorModel",
    "expertModel",
    "decisionRule",
    "qualifiedMajority",
    "roundLimit",
    "budgetCeiling",
    "asOf",
    "climate",
    "pressures",
    "scheduledEvents",
    "coldRatification",
    "seed"
  ]
}
