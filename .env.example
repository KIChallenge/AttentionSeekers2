# Copy to .env and fill in. Never commit real values.

# OpenAI-compatible gateway (Bifrost in front of Azure, or any compatible endpoint)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8080/v1
OPENAI_COMPATIBLE_API_KEY=

# Local Postgres + pgvector from docker-compose.yml (host port 55432)
DATABASE_URL=postgres://sv:sv@localhost:55432/sv

# Directory with cached runs (*.ndjson); used when the database is unreachable
SV_REPLAY_DIR=runs

# Optional: forecasting CLI called once at the end of a live run
SV_FORECAST_CMD=

# Azure Foundry seed for Bifrost
BIFROST_SEED_AZURE_KEY=
BIFROST_SEED_AZURE_ENDPOINT=https://<resource>.openai.azure.com/openai/v1

# AWS Bedrock API key for Bifrost
BIFROST_SEED_BEDROCK_KEY=
BIFROST_SEED_BEDROCK_REGION=eu-north-1

# ElevenLabs TTS (optional; Azure Speech is the fallback)
ELEVENLABS_API_KEY=
