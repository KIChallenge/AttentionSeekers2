  "segments": [
    {
      "id": "p-18821-s1",
      "sourceId": "p-18821",
      "ordinal": 1,
      "start": 0,
      "end": 117,
      "text": "Mit Stichtag 1. Juli sind österreichweit rund 290 Kassenstellen unbesetzt, zwei Drittel davon in ländlichen Regionen.",
      "textEn": null
    },
    {
      "id": "p-19544-s1",
      "sourceId": "p-19544",
      "ordinal": 1,
      "start": 0,
      "end": 133,
      "text": "Von den 650 im Vorjahr ausgeschriebenen Kassenstellen blieben 40 % ohne Bewerbung. Ursache ist die fehlende Attraktivität der Tarife.",
      "textEn": null
    },
    {
      "id": "p-20877-s1",
      "sourceId": "p-20877",
      "ordinal": 1,
      "start": 0,
      "end": 114,
      "text": "Telemedizinische Erstkontakte als Kassenleistung setzen klare Haftungsregeln und eine eigene Tarifposition voraus.",
      "textEn": null
    },
    {
      "id": "p-21003-s1",
      "sourceId": "p-21003",
      "ordinal": 1,
      "start": 0,
      "end": 112,
      "text": "Eine nationale Terminservicestelle über die Gesundheitshotline 1450 soll bis 2028 flächendeckend verfügbar sein.",
      "textEn": null
    },
    {
      "id": "p-22410-s1",
      "sourceId": "p-22410",
      "ordinal": 1,
      "start": 0,
      "end": 87,
      "text": "In mehreren Fächern warten Patient:innen länger als acht Wochen auf einen Kassentermin.",
      "textEn": null
    },
    {
      "id": "p-23118-s1",
      "sourceId": "p-23118",
      "ordinal": 1,
      "start": 0,
      "end": 84,
      "text": "Zusätzliche Dauerausgaben sind nur mit Gegenfinanzierung und Evaluierung vertretbar.",
      "textEn": null
    },
    {
      "id": "p-24002-s1",
      "sourceId": "p-24002",
      "ordinal": 1,
      "start": 0,
      "end": 130,
      "text": "Die Länder fordern eine Mitentscheidung bei der Planung von Primärversorgungseinheiten über die Landes-Zielsteuerungskommissionen.",
      "textEn": null
    },
    {
      "id": "p-24390-s1",
      "sourceId": "p-24390",
      "ordinal": 1,
      "start": 0,
      "end": 84,
      "text": "Ein relevanter Anteil der Ambulanzfälle wäre im niedergelassenen Bereich versorgbar.",
      "textEn": null
    },
    {
      "id": "p-24711-s1",
      "sourceId": "p-24711",
      "ordinal": 1,
      "start": 0,
      "end": 99,
      "text": "Pflegerischer Erstkontakt in Primärversorgungseinheiten kann ärztliche Routinekontrollen entlasten.",
      "textEn": null
    },
    {
      "id": "p-25001-s1",
      "sourceId": "p-25001",
      "ordinal": 1,
      "start": 0,
      "end": 123,
      "text": "Für Spitalsambulanzen sind im Folgejahr Pauschalzahlungen vorgesehen, aus denen 180 Mio. Euro umgeschichtet werden könnten.",
      "textEn": null
    },
    {
      "id": "p-30112-s1",
      "sourceId": "p-30112",
      "ordinal": 1,
      "start": 0,
      "end": 101,
      "text": "Median-Wartezeit auf einen Kassentermin: sechs Wochen in Augenheilkunde, fünf Wochen in Dermatologie.",
      "textEn": null
    },
    {
      "id": "s-asvg-342-s1",
      "sourceId": "s-asvg-342",
      "ordinal": 1,
      "start": 0,
      "end": 115,
      "text": "Der Gesamtvertrag regelt insbesondere die Festsetzung der Zahl und der örtlichen Verteilung der Vertragsärzt:innen.",
      "textEn": null
    }
  ],
